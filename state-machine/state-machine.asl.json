{
    "Comment": "A description of my state machine",
    "StartAt": "EnviarSolicitacaoAprovacaoAutomatica",
    "States": {
        "EnviarSolicitacaoAprovacaoAutomatica": {
            "Type": "Task",
            "Resource": "arn:aws:states:::sqs:sendMessage.waitForTaskToken",
            "Parameters": {
                "QueueUrl": "https://sqs.us-east-1.amazonaws.com/835996031136/send-aut-approval-queue",
                "MessageBody": {
                    "executionId.$": "$$.Execution.Id",
                    "taskToken.$": "$$.Task.Token",
                    "executionStartTime.$": "$$.Execution.StartTime",
                    "businessKey.$": "$.businessKey"
                }
            },
            "Next": "AvaliarResultadoAprovacaoAutomatica",
            "TimeoutSeconds": 120,
            "Catch": [
                {
                    "ErrorEquals": [
                        "States.Timeout"
                    ],
                    "Comment": "Tempo excedido aguardando resposta automática",
                    "Next": "HandleTimeout"
                },
                {
                    "ErrorEquals": [
                        "ValidationError"
                    ],
                    "ResultPath": "$.error",
                    "Comment": "Erro de validação, redirecionando para aprovação manual",
                    "Next": "RegistrarTarefaHumanaAprovacao"
                }
            ]
        },
        "RegistrarTarefaHumanaAprovacao": {
            "Type": "Task",
            "Resource": "arn:aws:states:::sqs:sendMessage.waitForTaskToken",
            "Parameters": {
                "MessageBody": {
                    "executionId.$": "$$.Execution.Id",
                    "taskToken.$": "$$.Task.Token",
                    "businessKey.$": "$.businessKey",
                    "executionStartTime.$": "$$.Execution.StartTime",
                    "error.$": "$.error"
                },
                "QueueUrl": "https://sqs.us-east-1.amazonaws.com/835996031136/register-human-task-approval-queue"
            },
            "Next": "DecidirReexecucao",
            "TimeoutSeconds": 140
        },
        "DecidirReexecucao": {
            "Type": "Choice",
            "Choices": [
                {
                    "Next": "EnviarSolicitacaoAprovacaoAutomatica",
                    "Variable": "$.retryApproval",
                    "BooleanEquals": true
                },
                {
                    "Next": "EncerrarComSucesso",
                    "Variable": "$.retryApproval",
                    "BooleanEquals": false
                }
            ]
        },
        "HandleTimeout": {
            "Type": "Fail"
        },
        "AvaliarResultadoAprovacaoAutomatica": {
            "Type": "Choice",
            "Choices": [
                {
                    "Next": "ProcessarAprovacao",
                    "Variable": "$.result",
                    "StringEquals": "APPROVED"
                },
                {
                    "Next": "ProcessarRejeicao",
                    "Variable": "$.result",
                    "StringEquals": "REJECTED"
                }
            ]
        },
        "ProcessarRejeicao": {
            "Type": "Pass",
            "Next": "EncerrarComSucesso"
        },
        "ProcessarAprovacao": {
            "Type": "Pass",
            "Next": "EncerrarComSucesso"
        },
        "EncerrarComSucesso": {
            "Type": "Succeed"
        }
    }
}