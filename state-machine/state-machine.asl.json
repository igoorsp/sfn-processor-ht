{
    "Comment": "A description of my state machine",
    "StartAt": "InitFlow",
    "States": {
        "InitFlow": {
            "Type": "Pass",
            "Next": "EnviarMsgAprovacao"
        },
        "EnviarMsgAprovacao": {
            "Type": "Task",
            "Resource": "arn:aws:states:::sqs:sendMessage.waitForTaskToken",
            "Parameters": {
                "QueueUrl": "https://sqs.us-east-1.amazonaws.com/835996031136/state-machine-queue",
                "MessageBody": {
                    "executionId.$": "$$.Execution.Id",
                    "taskToken.$": "$$.Task.Token",
                    "executionStartTime.$": "$$.Execution.StartTime",
                    "businessKey.$": "$.businessKey"
                }
            },
            "Next": "ValidarResult",
            "TimeoutSeconds": 120,
            "Catch": [
                {
                    "ErrorEquals": [
                        "States.Timeout"
                    ],
                    "Comment": "Timeout",
                    "Next": "Timeout"
                },
                {
                    "ErrorEquals": [
                        "ValidationError"
                    ],
                    "Comment": "CustomException",
                    "Next": "CustomException"
                }
            ]
        },
        "CustomException": {
            "Type": "Fail"
        },
        "Timeout": {
            "Type": "Fail"
        },
        "ValidarResult": {
            "Type": "Choice",
            "Choices": [
                {
                    "Next": "SuccessState",
                    "Variable": "$.result",
                    "StringEquals": "APPROVED"
                },
                {
                    "Next": "RejectedState",
                    "Variable": "$.result",
                    "StringEquals": "REJECTED"
                }
            ]
        },
        "RejectedState": {
            "Type": "Pass",
            "Next": "Success"
        },
        "SuccessState": {
            "Type": "Pass",
            "Next": "Success"
        },
        "Success": {
            "Type": "Succeed"
        }
    }
}