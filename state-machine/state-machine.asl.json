{
    "Comment": "Workflow de Aprovação com Repetição Automática",
    "StartAt": "InicializarRetryCount",
    "States": {
        "InicializarRetryCount": {
            "Type": "Pass",
            "Parameters": {
                "retryCount": 0,
                "businessKey.$": "$.businessKey"
            },
            "Next": "EnviarSolicitacaoAprovacaoAutomatica"
        },
        "EnviarSolicitacaoAprovacaoAutomatica": {
            "Type": "Task",
            "Resource": "arn:aws:states:::sqs:sendMessage.waitForTaskToken",
            "Parameters": {
                "QueueUrl": "https://sqs.us-east-1.amazonaws.com/835996031136/send-aut-approval-queue",
                "MessageBody": {
                    "executionId.$": "$$.Execution.Id",
                    "taskToken.$": "$$.Task.Token",
                    "executionStartTime.$": "$$.Execution.StartTime",
                    "businessKey.$": "$.businessKey",
                    "retryCount.$": "$.retryCount"
                }
            },
            "Next": "AvaliarResultadoAprovacaoAutomatica",
            "TimeoutSeconds": 120,
            "Retry": [
                {
                    "ErrorEquals": [
                        "States.Timeout"
                    ],
                    "IntervalSeconds": 5,
                    "MaxAttempts": 2,
                    "BackoffRate": 1.5,
                    "Comment": "Approval response not received within timeout period"
                }
            ],
            "Catch": [
                {
                    "ErrorEquals": [
                        "States.Timeout"
                    ],
                    "Next": "HandleTimeout"
                },
                {
                    "ErrorEquals": [
                        "ValidationError"
                    ],
                    "ResultPath": "$.error",
                    "Next": "RegistrarTarefaHumanaAprovacao"
                }
            ]
        },
        "RegistrarTarefaHumanaAprovacao": {
            "Type": "Task",
            "Resource": "arn:aws:states:::sqs:sendMessage.waitForTaskToken",
            "Parameters": {
                "QueueUrl": "https://sqs.us-east-1.amazonaws.com/835996031136/register-human-task-approval-queue",
                "MessageBody": {
                    "executionId.$": "$$.Execution.Id",
                    "taskToken.$": "$$.Task.Token",
                    "businessKey.$": "$.businessKey",
                    "executionStartTime.$": "$$.Execution.StartTime",
                    "retryCount.$": "$.retryCount",
                    "error.$": "$.error"
                }
            },
            "Next": "DecidirReexecucao",
            "TimeoutSeconds": 140,
            "ResultPath": "$.humanApprovalResult"
        },
        "DecidirReexecucao": {
            "Type": "Choice",
            "Choices": [
                {
                    "Variable": "$.humanApprovalResult.retryApproval",
                    "BooleanEquals": true,
                    "Next": "IncrementarRetryCount"
                },
                {
                    "Variable": "$.humanApprovalResult.retryApproval",
                    "BooleanEquals": false,
                    "Next": "EncerrarComSucesso"
                }
            ]
        },
        "IncrementarRetryCount": {
            "Type": "Pass",
            "Parameters": {
                "businessKey.$": "$.humanApprovalResult.businessKey",
                "retryCount.$": "States.MathAdd($.retryCount, 1)"
            },
            "Next": "EnviarSolicitacaoAprovacaoAutomatica"
        },
        "AvaliarResultadoAprovacaoAutomatica": {
            "Type": "Choice",
            "Choices": [
                {
                    "Variable": "$.result",
                    "StringEquals": "APPROVED",
                    "Next": "ProcessarAprovacao"
                },
                {
                    "Variable": "$.result",
                    "StringEquals": "REJECTED",
                    "Next": "ProcessarRejeicao"
                }
            ]
        },
        "ProcessarRejeicao": {
            "Type": "Pass",
            "Parameters": {
                "status": "REJECTED",
                "originalInput.$": "$"
            },
            "Next": "EncerrarComSucesso"
        },
        "ProcessarAprovacao": {
            "Type": "Pass",
            "Parameters": {
                "status": "APPROVED",
                "originalInput.$": "$"
            },
            "Next": "EncerrarComSucesso"
        },
        "HandleTimeout": {
            "Type": "Fail",
            "Error": "ExecutionTimeout",
            "Cause": "Tempo limite excedido durante a aprovação automática"
        },
        "EncerrarComSucesso": {
            "Type": "Succeed"
        }
    }
}